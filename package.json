  "description": "Generate Dockerfile from a simple YAML spec",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "docker-yaml": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
